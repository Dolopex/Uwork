# ── U-Work — variables de entorno ──────────────────────────────────
# Copia este archivo a .env y ajústalo. Nunca subas .env al repositorio.
#
#   cp .env.example .env

# ── Django ─────────────────────────────────────────────────────────
# DEBUG=True en desarrollo; en producción debe ser False (activa HSTS,
# cookies seguras y redirección a HTTPS).
DEBUG=True

# Clave secreta. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-de-produccion

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.neon.tech

# Orígenes de confianza para el token CSRF. En producción debe incluir el
# dominio real con https:// (Vercel cambia el dominio de las previsualizaciones).
CSRF_TRUSTED_ORIGINS=

# ── Base de datos ──────────────────────────────────────────────────
# Si no se define, se usa el SQLite local (db.sqlite3).
# DATABASE_URL=postgresql://usuario:clave@host/neon?sslmode=require

# ── Correo ─────────────────────────────────────────────────────────
# URL pública de la aplicación (sin barra final). Se usa en los enlaces de
# verificación de email, de sanción y de apelación.
SITE_URL=http://localhost:8000

DEFAULT_FROM_EMAIL=no-reply@uwork.app

# API key de Resend. Sin ella los correos se imprimen en la consola
# (útil en desarrollo, inútil en producción).
RESEND_API_KEY=

# ── Almacenamiento de archivos ──────────────────────────────────────
# En Vercel el disco local no persiste: las imágenes de perfil se pierden.
# Define STORAGE_BACKEND con django-storages y sus credenciales.
# STORAGE_BACKEND=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# ── Moderación ─────────────────────────────────────────────────────
# SLA de respuesta a reportes de contenido, en horas.
MODERATION_SLA_HOURS=48

# ── Dominios institucionales admitidos para registro de estudiantes ──
INSTITUTIONAL_DOMAINS=campusuninunez.edu.co
